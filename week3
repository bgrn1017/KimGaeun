#include <iostream>
#include <string>

using namespace std;


int find_account(string name[], int count, string f_name) {     // Call by Value - 해당 주소에 어떤 값이 있는지만 확인하면 됨
    for (int i = 0; i < count; i++) {
        if (name[i] == f_name) {        
            return i; // 찾으면 해당 인덱스 반환
        }
    }
    return -1; // 못 찾으면 -1 반환
}


void plus_money(int* money, int amount) {       // 입금 함수
    *money += amount;       // Call by Address (int* money) - 포인터 변수 money가 가리키는 주소 내부의 값을 바꾸면 원본의 값도 바뀜!
                            // 원래 있던 잔액 + 입금한 금액을 저장해야하므로 += 연산자 사용
}


int minus_money(int& money, int amount) {       // 출금 함수
    if (money >= amount) {      // Call by Reference (int& money) - 참조 변수 money가 받은 값의 별명이 되어 참조 변수의 값이 수정되면 원본의 값도 바뀜!
        money -= amount;        // 원래 있던 잔액 - 출금한 금액을 저장해야하므로 -= 연산자 사용
        return 1;
    }
    return 0;
}


int main() {
    string name[100];  // 계좌에 등록된 이름
    int money[100];   // 계좌 잔액
    int total_acc = 0; // 현재 등록된 계좌 수

    int num;

    while (true) {
        cout << "\n============= 은행 계좌 관리 시스템 =============" << endl;
        cout << "1. 현재 등록된 계좌 리스트 보기" << endl;
        cout << "2. 신규 계좌 등록" << endl;
        cout << "3. 입금 및 출금" << endl;
        cout << "4. 계좌 간 이체" << endl;
        cout << "5. 프로그램 종료" << endl;
        cout << ">> 메뉴 선택 : ";
        cin >> num;

        if (num == 1) {  // 1. 현재 등록된 계좌 리스트 보기
            cout << "\n-------- [현재 등록된 계좌 리스트] --------" << endl;
            if (total_acc == 0) {
                cout << "(등록된 계좌가 없습니다.)" << endl;
            }
            else {
                for (int i = 0; i < total_acc; i++) {
                    cout << i + 1 << ". 이름 : " << name[i] << "         " << "| 잔액 : " << money[i] << "원" << endl;
                }
            }
            cout << "-------------------------------------------" << endl;
        }
        
        else if (num == 2) {        // 2. 신규 계좌 등록
            cout << "\n[신규 계좌 등록]" << endl;
            string new_name;
            int fir_money;

            cout << "등록할 이름 : ";
            cin >> new_name;
            cout << "초기 잔액 : ";
            cin >> fir_money;

            
            name[total_acc] = new_name;     // 이름 배열의 맨 뒤에 새로운 이름 저장
            money[total_acc] = fir_money;       // 계좌 배열의 맨 뒤에 새로운 계좌 저장
            total_acc++;        // 총 계좌 수 +1

            cout << "신규 계좌 등록 완료했습니다." << endl;
        }
       
        else if (num == 3) {
            string f_name;
            cout << "\n조회할 이름을 입력하세요 : ";
            cin >> f_name;

            int user = find_account(name, total_acc, f_name); // 매개변수 name[], count[], f_name에게 name, total_acc, f_name 값 넘겨줌

            if (user == -1) {   // 사용자 인덱스가 존재하지 않을 경우
                cout << "존재하지 않는 사용자입니다." << endl;
            }
            else {
                cout << "현재 " << name[user] << "님의 잔액 : " << money[user] << "원" << endl;
                cout << "(1) 입금 | (2) 출금 : ";

                int deal;
                cin >> deal;

                if (deal == 1) { // (1) 입금 선택한 경우
                    int amount;
                    cout << "거래 금액 입력 : ";
                    cin >> amount;
                    plus_money(&money[user], amount);       // 매개함수 money, amount에게 money[user]의 주소값, amount의 값을 넘겨줌
                    cout << amount << "원 입금 완료했습니다." << endl;
                }
                else if (deal == 2) { // (2) 출금 선택한 경우
                    int amount;
                    cout << "거래 금액 입력 : ";
                    cin >> amount;

                    if (minus_money(money[user], amount) == 1) {        // 매개함수 money, amount에게 money[user], amount 값을 넘겨줌
                        cout << amount << "원 출금 완료했습니다." << endl;
                    }
                    else {
                        cout << "잔액이 부족합니다." << endl;
                    }
                }
                else {      // 입금(1), 출금(2)을 선택하지 않은 경우
                    cout << "올바른 번호를 입력하세요 (1 또는 2)." << endl;
                }
            }
        }
        
        else if (num == 4) {        // 4. 계좌 간 이체
            cout << "\n[계좌 간 이체]" << endl;
            string to, from;

            cout << "보내는 분 이름: ";
            cin >> to;
            cout << "받는 분 이름: ";
            cin >> from;
            
            int amount;
            cout << "이체할 금액 : ";
            cin >> amount;

            int amount;

            int to_acc = find_account(name, total_acc, to);
            int from_acc = find_account(name, total_acc, from);

            if (to_acc == -1 || from_acc == -1) {       // 보내는 사람, 받는 사람 둘 중 한 명이라도 계좌 정보가 없는 경우
                cout << "존재하지 않는 사용자입니다." << endl;
            }
            else {
                if (minus_money(money[to_acc], amount) == 1) {     // 이체 성공하여 1 반환
                    plus_money(&money[from_acc], amount);
                    cout << "이체가 완료되었습니다." << endl;
                }
                else {
                    cout << "잔액이 부족합니다." << endl;
                }
            }
        }
        // 5. 프로그램 종료
        else if (num == 5) {
            cout << "프로그램을 종료합니다." << endl;
            break; // while 무한 루프 탈출
        }

        else {      // 1~5번 외 다른 번호 선택
            cout << "올바른 번호를 입력해주세요." << endl;
        }
    }

    return 0;
}
