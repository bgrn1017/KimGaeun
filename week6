#include <iostream>
using namespace std;

template <typename T>
class Node {    // 노드 클래스 템플릿
public:
    T data; // 노드 안의 내용을 담을 변수
    Node<T>* next;  // 포인터변수 next (다음 노드의 주소 저장)

    Node(T d) {
        data = d;   // 받은 값을 data에 넣음
        next = nullptr; // 처음엔 노드가 1개니까 저장할 값이 없음
    }
};

template <typename T>
class LinkedList {  // 링크드리스트 클래스 템플릿
private:
    Node<T>* head;  // 포인터변수 head (맨 첫번째 노드 주소)

public:
    LinkedList() {
        head = nullptr; // 처음엔 비워둠
    }

    void append(T value) {  // 리스트 맨 뒤에 새 노드를 생성하는 함수
        Node<T>* newNode = new Node<T>(value);  // 새로운 노드 생성

        if (head == nullptr) {  // 리스트가 비어있는 경우
            head = newNode; // 새로 만든 노드를 첫 번째 노드로 저장
            return;
        }

        Node<T>* current = head;    // 첫번째 노드부터 출발

        while (current->next != nullptr) {  // 마지막 노드를 찾을 때까지
        current = current->next;    // 변수에 저장된 다음 노드의 주소를 따라 이동
        }

        current->next = newNode;    // 마지막 노드에 방금 만든 노드 위치 저장
    }

    ~LinkedList() {     // 소멸자
        Node<T>* current = head;    // 첫번째 노드부터 출발
        while (current != nullptr) {        // 마지막 노드를 찾을 때까지
            Node<T>* nextNode = current->next;      // 다음 노드의 주소를 미리 저장
            delete current;     // 현재 노드 제거 
            current = nextNode;     // 다음 노드로 이동
        }
    }

    template <typename T>
    friend void printList(const LinkedList<T>& list);   // 포인터변수 head를 외부 함수에서도 사용하기 위해 friend 함수 선언

    LinkedList(const LinkedList<T>& other) {        // 복사생성자
        head = nullptr;
        Node<T>* current = other.head;
        while (current != nullptr) {
            append(current->data);
            current = current->next;
        }
    }
};

template <typename T>   // 출력 함수 템플릿
void printList(const LinkedList<T>& list) {
    Node<T>* current = list.head;   // 첫번째 노드부터 시작
    while (current != nullptr) {    // 마지막 노드가 나올 때까지 반복
        cout << current->data << " -> ";    // 현재 노드의 값 출력 후
        current = current->next;    // 변수에 저장된 다음 노드의 주소를 따라 이동
    }
    cout << "끝" << endl;    // 마지막 노드에 도착하면 "끝" 출력
}

int main() {
    cout << "============= int 타입 리스트 =============" << endl;

    LinkedList<int> intList; // 정수형으로 들어와서 정수형 리스트 생성
    intList.append(10);
    intList.append(20);
    intList.append(30);

    cout << "int 타입 리스트 : ";
    printList(intList); // 함수 템플릿 호출

    cout << endl;
    cout << "============= double 타입 리스트 =============" << endl;

    LinkedList<double> doubleList; // 템플릿을 이용하여 코드 재사용 가능
    doubleList.append(10.5);
    doubleList.append(20.2);
    doubleList.append(30.8);

    cout << "double 타입 리스트 : ";
    printList(doubleList);

    return 0;
}
